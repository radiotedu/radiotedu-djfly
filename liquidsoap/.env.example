# Sadece Liquidsoap calisma ortami icin. Repoya gercek deger yazma.
# DJFLY_* yolu, ICECAST_* yayin PC'sindeki ortama aittir.
DJFLY_NODE_BIN=node
DJFLY_BRIDGE=/opt/djfly/liquidsoap/djfly-next.mjs
DJFLY_POOL_PATH=/opt/djfly/local/pools/canli.json
DJFLY_STATE_PATH=/var/lib/djfly/state.json
DJFLY_LAST_PATH=/var/lib/djfly/last.txt
MUZIK_DIR=/opt/radiotedu/muzik
DJFLY_FALLBACK_M3U=/opt/radiotedu/muzik/playlist_gunluk.m3u
DJFLY_FALLBACK_JINGLE=/opt/radiotedu/muzik/jingle_yedek.mp3
DJFLY_NOTIFY_SH=/opt/djfly/liquidsoap/on_track.sh
DJFLY_LOG_DIR=/var/log/radiotedu
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_PASS=
ICECAST_MOUNT=/sinek.mp3
